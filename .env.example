# Server-side environment only. Add these in the AMYO Vercel project settings.
# Never put a Supabase secret/service_role key inside dist/ or browser JavaScript.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_A_SECRET_KEY_OR_LEGACY_SERVICE_ROLE_JWT
ALLOWED_ORIGIN=https://amyoconstruction.com

# Optional: permit only this deployment's exact VERCEL_URL in Vercel previews.
# Leave false for production; VERCEL, VERCEL_ENV and VERCEL_URL are set by Vercel.
ALLOW_VERCEL_PREVIEWS=false

